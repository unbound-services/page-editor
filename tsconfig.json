{
  "compilerOptions": {
    "outDir": "types_raw",
    "declaration": true,
    "inlineSourceMap": false,
    "skipLibCheck": true,
    "noImplicitAny": false,
    "declarationMap": true, // (Optional) Source maps for .d.ts
    "emitDeclarationOnly": true, // Prevents generating .js files (optional)
    "module": "ESNext",
    "lib": [
      "ESNext",
      "dom"
    ],
    // "lib": ["es2015", "es2016", "es2017", "dom"],
    // "lib": [  "es6"],
    "target": "es6",
    "jsx": "react",
    // "jsxImportSource": "react",
    "moduleResolution": "node",
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": false,
    "strictNullChecks": false,
    "strictFunctionTypes": true,
    // "types":["@types/jest","node"],
    "typeRoots": [
      "node_modules/@types",
    ],
    // "paths": {
    //   //   "react": [
    //   //     "node_modules/preact/compat"
    //   //   ],
    //   //   "react-dom": [
    //   //     "node_modules/preact/compat"
    //   //   ],
    // }
  },
  "include": [
    "src/lib/**/*",
    "src/global.d.ts"
  ],
  "ts-node": {
    // these options are overrides used only by ts-node
    "compilerOptions": {
      "module": "ESNext"
    }
  },
}